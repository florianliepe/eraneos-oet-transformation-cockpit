{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eraneos.com/oet/transformation-cockpit/review-record/1.0.0",
  "title": "Review record",
  "type": "object",
  "required": ["id", "object", "objectVersion", "status", "requestedAt", "requestedBy", "reviewer", "rationale", "evidenceIds"],
  "properties": { "id": { "type": "string", "minLength": 1 }, "object": { "type": "object", "required": ["type", "id"] }, "objectVersion": { "type": "integer", "minimum": 1 }, "status": { "enum": ["pending", "approved", "changes_requested", "rejected"] }, "requestedAt": { "type": "string", "format": "date-time" }, "requestedBy": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "format": "date-time" }, "rationale": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }
}
