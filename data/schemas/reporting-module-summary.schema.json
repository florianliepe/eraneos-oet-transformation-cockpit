{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eraneos.com/oet/transformation-cockpit/reporting-module-summary/1.0.0",
  "title": "Reporting module summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleId",
    "label",
    "version",
    "sourceRevision",
    "freshness",
    "metrics",
    "claims",
    "missingEvidence"
  ],
  "properties": {
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "freshness": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "array"
    },
    "claims": {
      "type": "array"
    },
    "missingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

